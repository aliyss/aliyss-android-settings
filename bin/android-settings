#!/data/data/com.termux/files/usr/bin/sh
# android-settings — declarative Android settings + hook services for the
# aliyss phone (repo: aliyss-android-settings, wired via home-manager).
#
# The engine lives in this repo (same pattern as aliyss-android-pkgs: the
# repo owns the engine, home-manager just calls it). It runs natively in a
# Termux shell and inside the nix chroot (home-manager activation); anything
# privileged goes through `su` (KernelSU) — or, where the chroot hides the real
# su, through KernelSU's ksud CLI via a generated shim (see resolve_su) — so the
# process itself stays in the app's SELinux domain — runit can always supervise
# the hooks.
#
# Usage:
#   android-settings apply [--dry-run] [NAME|FILE...]
#   android-settings verify [NAME|FILE...]
#   android-settings list-props
#   android-settings sync-hooks [--env-dir DIR] [--dry-run] NAME...
#       Install/refresh exactly NAME... (each session's env read from
#       <DIR>/<name>.env when given), remove hooks the previous run declared and
#       this one does not, and remember the list in
#       ~/.local/state/aliyss-android-settings/hooks. Installing is what creates
#       the runit service; an unchanged hook is left alone (no restart).
#   android-settings notify TITLE [BODY] [TAG]   (root; no Termux:API needed)
#   android-settings qs-list                (current QS tiles, one per line)
#   android-settings qs-add TILE...         (merge into the QS panel)
#   android-settings qs-remove TILE...      (drop from the QS panel)
#   android-settings disable-app PKG...     (pm disable-user --user 0)
#   android-settings enable-app PKG...      (pm enable)
#   android-settings list-disabled
#   android-settings install-hook NAME [--env-file FILE]
#   android-settings remove-hook NAME
#   android-settings list-hooks
#
# A manifest argument is a path (anything with a slash or a .props suffix), a
# bare name resolved against props/ (<name>.props), or `all` for every manifest
# in props/ sorted. With no argument, props/default.props is used.
#
# Manifest format (see props/default.props):
#   # comment
#   global.window_animation_scale = 0.75   # namespace.key = value
#   cmd:wm density 440                     # raw command, run as root
#   qs.add = flashlight                    # ensure QS tiles are in the panel
#   qs.remove = cast                       # ensure QS tiles are not in the panel
set -eu

# $PREFIX is a Termux-shell concept: inside the nix chroot (home-manager
# activation) it is unset, so default to the standard Termux prefix.
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
BIN_DIR=$(dirname "$SELF")
ROOT=$(dirname "$BIN_DIR")

# In-store layout ($out/share/...) vs in-tree layout (hooks/ next to bin/).
if [ -d "$ROOT/share/android-settings/hooks" ]; then
  HOOKS_DIR="$ROOT/share/android-settings/hooks"
  PROPS_DIR="$ROOT/share/android-settings/props"
  LIB_DIR="$ROOT/share/android-settings/lib"
else
  HOOKS_DIR="$ROOT/hooks"
  PROPS_DIR="$ROOT/props"
  LIB_DIR="$ROOT/lib"
fi

# Shared helpers (notify.sh). Optional so the engine still works if only the
# binary was copied out of the store.
[ -f "$LIB_DIR/notify.sh" ] && . "$LIB_DIR/notify.sh"

STATE_BASE="$HOME/.local/state/aliyss-android-settings"
HOOKS_STATE="$STATE_BASE/hooks"
LOG_BASE="$HOME/.local/state/aliyss-android-settings/logs"
LIBEXEC_DIR="$HOME/.local/libexec/android-settings"
SERVICE_BASE="$PREFIX/var/service/android-settings"

log() { printf '[android-settings] %s\n' "$*"; }
warn() { printf '[android-settings] !! %s\n' "$*" >&2; }
die() { warn "$*"; exit 1; }

# Root is needed for settings get/put, cmd, pm — everything this engine does.
# su is not in the activation script's PATH (KernelSU puts it on /system, not
# in the Termux prefix), so resolve it from the standard locations.
#
# Two shapes of "no su" have to work:
#
#   native Termux — /system/bin/su (KernelSU/Magisk) or `su` on PATH elevates;
#   the Nix chroot — the real su is hidden (/system/bin/su and /data/adb are not
#     mounted) and $PREFIX/bin/su is the Termux stub that only prints "No su
#     program found". Root there comes from KernelSU's ksud CLI: libksud.so is a
#     plain file under $HOME and `debug su -g` runs a command in the global
#     mount namespace — the same route the interactive fish su/sudo functions
#     use.
#
# The ksud route is wrapped in a generated `su -c` shim so $SU_BIN keeps its
# meaning for everything that uses it (lib/notify.sh sources this file and calls
# "$SU_BIN" -c ... directly).
SU_BIN=""
KSUD_LIB="${KSUD_LIB:-$HOME/sukisu-mgr/lib/arm64-v8a/libksud.so}"
KSUD_LINKER="${KSUD_LINKER:-/system/bin/linker64}"

# A candidate is only good if it really elevates: inside the chroot the Termux
# stub sits at the front of the search order and always fails.
su_confirmed() { # $1 = candidate binary
  _cand_out=$("$1" -c 'id -u' 2>/dev/null) || return 1
  # `id -u` prints "0\n"; word-splitting trims it without needing tr/sed.
  for _cand_w in $_cand_out; do
    [ "$_cand_w" = 0 ] && return 0
  done
  return 1
}

# Generate (once) the `su -c` shim over libksud.so and print its path.
write_ksud_shim() {
  _shim="$STATE_BASE/su-ksud"
  # Regenerate when missing or when it points at a different libksud (the path
  # can move with a SukiSU update). NOTE: this heredoc is unquoted, so backticks
  # and $ must not appear in it — a stray pair would run a command here.
  if [ ! -x "$_shim" ] || ! grep -q "$KSUD_LIB" "$_shim" 2>/dev/null; then
    mkdir -p "$STATE_BASE" 2>/dev/null || return 1
    cat >"$_shim" <<EOF
#!/data/data/com.termux/files/usr/bin/sh
# Generated by android-settings — do not edit.
# su -c 'cmd' over KernelSU's ksud CLI, for hosts where the real su is not
# reachable (inside the Nix chroot). Commands are read on stdin, -g selects the
# global mount namespace, and the last command's exit status is propagated.
[ "\${1:-}" = "-c" ] && shift
printf '%s\\n' "\$*" | "$KSUD_LINKER" "$KSUD_LIB" debug su -g
EOF
    chmod 700 "$_shim" || return 1
  fi
  printf '%s' "$_shim"
}

resolve_su() {
  [ -n "$SU_BIN" ] && return 0
  for c in su /system/bin/su /system/xbin/su /sbin/su; do
    _cand=$(command -v "$c" 2>/dev/null) || continue
    [ -n "$_cand" ] || continue
    if su_confirmed "$_cand"; then
      SU_BIN=$_cand
      return 0
    fi
  done
  if [ -x "$KSUD_LINKER" ] && [ -f "$KSUD_LIB" ]; then
    SU_BIN=$(write_ksud_shim) && [ -n "$SU_BIN" ] && return 0
    SU_BIN=""
  fi
  return 1
}
need_root() {
  resolve_su || die "no root available (need KernelSU/Magisk su, or libksud.so)"
}
as_root() {
  resolve_su || return 1
  # The root shell does NOT always get a useful PATH (seen during the
  # home-manager switch: `settings: inaccessible or not found`), so pin the
  # Android system dirs in front of whatever PATH it inherits.
  # The dir must exist or the redirection below fails and every root call looks
  # like a denial (nothing else creates it on a fresh device).
  mkdir -p "$STATE_BASE" 2>/dev/null || true
  _err="$STATE_BASE/su.err"
  _i=0
  while :; do
    if "$SU_BIN" -c "PATH=/system/bin:/system/xbin:/vendor/bin:\$PATH; export PATH; $1" 2>"$_err"; then
      return 0
    fi
    _i=$((_i + 1))
    [ "$_i" -ge 3 ] && break
    sleep 1
  done
  warn "su failed ($(head -c 200 "$_err" 2>/dev/null || true))"
  return 1
}

# Escape single quotes for the inner shell su -c spawns.
esc() { printf '%s' "$1" | sed "s/'/'\\\\''/g"; }

# ---------------------------------------------------------------- manifest
# Parse + process a manifest. process_line() is set by the caller.
process_manifest() {
  file=$1
  [ -f "$file" ] || die "manifest not found: $file"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '' | '#'*) continue ;;
    esac
    # Trim leading whitespace.
    line=${line#"${line%%[![:space:]]*}"}
    case "$line" in '' | '#'*) continue ;; esac
    process_line "$line" || return 1
  done <"$file"
}

# --------------------------------------------------------------- apply/verify
DRY_RUN=0

settings_line() { # $1 = "ns.key", $2 = value, $3 = mode (put|check)
  ns=${1%%.*}
  key=${1#*.}
  case "$ns" in
    global | system | secure) : ;;
    *)
      warn "bad namespace in: $1 = $2 (global|system|secure)"
      return 1
      ;;
  esac
  case "$key" in
    '' | *'.'*) warn "bad key in: $1 = $2"; return 1 ;;
  esac

  if [ "$3" = put ]; then
    if [ "$DRY_RUN" = 1 ]; then
      log "would set: $ns.$key = $2"
      return 0
    fi
    if as_root "settings put $ns '$(esc "$key")' '$(esc "$2")'"; then
      log "set: $ns.$key = $2"
      return 0
    fi
    warn "settings put failed: $ns.$key"
    return 1
  fi

  # check (verify mode)
  cur=$(as_root "settings get $ns '$(esc "$key")'" || true)
  if [ "$cur" = "$2" ]; then
    log "ok: $ns.$key = $2"
  else
    warn "diff: $ns.$key — current '${cur:-<unset>}' wanted '$2'"
    return 1
  fi
}

cmd_line() { # $1 = raw command, $2 = mode (put|check)
  if [ "$2" = put ]; then
    if [ "$DRY_RUN" = 1 ]; then
      log "would run: $1"
      return 0
    fi
    if as_root "$1"; then
      log "ran: $1"
    else
      warn "cmd failed: $1"
      return 1
    fi
  else
    log "cmd (not verifiable): $1"
  fi
}

do_apply() {
  rc=0
  for m in "$@"; do
    process_line() {
      case "$1" in
        cmd:*) cmd_line "${1#cmd:}" put ;;
        qs.*) qs_line "$1" put || rc=1 ;;
        *)
          nskey=${1%%=*}
          value=${1#*=}
          # Trim whitespace around key and value.
          nskey=${nskey%"${nskey##*[![:space:]]}"}
          value=${value#"${value%%[![:space:]]*}"}
          settings_line "$nskey" "$value" put || rc=1
          ;;
      esac
    }
    process_manifest "$m" || rc=1
  done
  return "$rc"
}

do_verify() {
  rc=0
  for m in "$@"; do
    process_line() {
      case "$1" in
        cmd:*) cmd_line "${1#cmd:}" check ;;
        qs.*) qs_line "$1" check || rc=1 ;;
        *)
          nskey=${1%%=*}
          value=${1#*=}
          nskey=${nskey%"${nskey##*[![:space:]]}"}
          value=${value#"${value%%[![:space:]]*}"}
          settings_line "$nskey" "$value" check || rc=1
          ;;
      esac
    }
    process_manifest "$m" || rc=1
  done
  return "$rc"
}

# ------------------------------------------------------------------- hooks
valid_hook_name() {
  case "$1" in
    '' | *[!a-z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

hook_service_dir() { printf '%s-%s' "$SERVICE_BASE" "$1"; }

svc_cmd() { # $1... = sv args
  SV="$PREFIX/bin/sv"
  command -v sv >/dev/null 2>&1 && SV=$(command -v sv)
  SVDIR="$PREFIX/var/service" "$SV" "$@" >/dev/null 2>&1 || true
}

install_hook() { # $1 = name, $2 = env file ("" = none)
  name=$1
  env_file=$2
  valid_hook_name "$name" || die "invalid hook name: '$name'"
  [ -d "$HOOKS_DIR/$name" ] || die "no such hook: $name"
  [ -x "$HOOKS_DIR/$name/run" ] || die "hook '$name' has no executable run script"
  need_root

  hook_real="$LIBEXEC_DIR/hooks/$name"
  service="$(hook_service_dir "$name")"
  mkdir -p "$hook_real"

  # Copy the hook out of the store as REAL files: /nix is invisible to native
  # Termux processes (and to runsv), same trick as the tailscaled daemon.
  cp -f "$HOOKS_DIR/$name/run" "$hook_real/run"
  chmod 755 "$hook_real/run"
  if [ -f "$HOOKS_DIR/$name/defaults" ]; then
    cp -f "$HOOKS_DIR/$name/defaults" "$hook_real/defaults"
  fi
  if [ -n "$env_file" ]; then
    [ -f "$env_file" ] || die "env file not found: $env_file"
    cp -f "$env_file" "$hook_real/env"
  else
    rm -f "$hook_real/env"
  fi

  # Shared helpers live next to the hooks: a runit-spawned hook runs natively
  # in Termux, where the nix store is invisible, so it cannot use this engine.
  if [ -f "$LIB_DIR/notify.sh" ]; then
    mkdir -p "$LIBEXEC_DIR/lib"
    cp -f "$LIB_DIR/notify.sh" "$LIBEXEC_DIR/lib/notify.sh"
    chmod 644 "$LIBEXEC_DIR/lib/notify.sh"
  fi

  mkdir -p "$service"
  cat >"$service/run" <<EOF
#!/data/data/com.termux/files/usr/bin/sh
# android-settings hook service: $name
# Managed by home-manager (aliyss.androidSettings) — do not edit by hand.
HOOK_DIR="\$HOME/.local/libexec/android-settings/hooks/$name"
# set -a: sourced vars must be EXPORTED — the hook is started with `exec`,
# which starts a fresh process that only inherits exported variables.
set -a
[ -f "\$HOOK_DIR/defaults" ] && . "\$HOOK_DIR/defaults"
[ -f "\$HOOK_DIR/env" ] && . "\$HOOK_DIR/env"
set +a
LOG_DIR="\$HOME/.local/state/aliyss-android-settings/logs"
mkdir -p "\$LOG_DIR"
{
  echo "=== $name hook spawned by runit at \$(date '+%Y-%m-%d %H:%M:%S') ==="
  exec "\$HOOK_DIR/run"
} >> "\$LOG_DIR/$name.log" 2>&1
EOF
  chmod 755 "$service/run"
  # No `down` file => termux-services autostarts the hook at Termux boot.
  rm -f "$service/down"

  if [ -d "$service/supervise" ]; then
    svc_cmd restart "android-settings-$name"
  else
    # runsvdir notices new dirs within a few seconds; `up` may fail until
    # then — harmless, the hook autostarts.
    svc_cmd up "android-settings-$name"
  fi
  log "hook installed: $name (service: android-settings-$name)"
}

remove_hook() { # $1 = name
  name=$1
  valid_hook_name "$name" || die "invalid hook name: '$name'"
  service="$(hook_service_dir "$name")"
  if [ -d "$service/supervise" ]; then
    svc_cmd down "android-settings-$name"
    sleep 1
  fi
  # runsv has exited after `sv down` + dir removal; never rm supervise/ of a
  # LIVE runsv (termux-services wedge, see tailscale.nix).
  rm -rf "$service"
  rm -rf "$LIBEXEC_DIR/hooks/$name"
  log "hook removed: $name"
}

# Declarative hook management for the nix side (home-manager activation): the
# caller passes the FULL list of hooks it wants, and this diffs it against what
# the previous run declared (tracked in $HOOKS_STATE, the file home-manager's
# activation used before this command existed). Installing is what creates the
# runit service, so nothing here runs a hook by itself either.
#
hook_installed() { # $1 = name
  [ -f "$LIBEXEC_DIR/hooks/$1/run" ]
}

hook_env_current() { # $1 = name, $2 = wanted env file ("" = none)
  _installed="$LIBEXEC_DIR/hooks/$1/env"
  if [ -n "$2" ]; then
    [ -f "$_installed" ] && cmp -s "$2" "$_installed"
  else
    [ ! -f "$_installed" ]
  fi
}

in_list() { # $1 = needle, $2... = haystack
  _needle=$1
  shift
  for _candidate in "$@"; do
    if [ "$_candidate" = "$_needle" ]; then
      return 0
    fi
  done
  return 1
}

sync_hooks() { # [--env-dir DIR] [--dry-run] NAME...
  env_dir=""
  desired=""
  rc=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --env-dir)
        [ $# -ge 2 ] || die "--env-dir needs an argument"
        env_dir=$2
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        desired="$desired $1"
        shift
        ;;
    esac
  done

  # A missing env dir is a caller bug, not "no config": failing loudly beats
  # silently installing every hook without its hookConfig env file.
  if [ -n "$env_dir" ] && [ ! -d "$env_dir" ]; then
    die "env dir not found: $env_dir"
  fi

  mkdir -p "$STATE_BASE"
  previous=""
  [ -f "$HOOKS_STATE" ] && previous=$(cat "$HOOKS_STATE" 2>/dev/null)

  # Install or refresh everything declared.
  for name in $desired; do
    if ! valid_hook_name "$name"; then
      warn "invalid hook name: '$name'"
      rc=1
      continue
    fi
    if [ ! -x "$HOOKS_DIR/$name/run" ]; then
      warn "no such hook in this package: $name (skipped)"
      rc=1
      continue
    fi

    env_file=""
    if [ -n "$env_dir" ] && [ -f "$env_dir/$name.env" ]; then
      env_file="$env_dir/$name.env"
    fi

    if hook_installed "$name" && hook_env_current "$name" "$env_file"; then
      log "unchanged: $name"
      continue
    fi
    if [ "$DRY_RUN" = 1 ]; then
      log "would install: $name (env: ${env_file:-none})"
      continue
    fi
    install_hook "$name" "$env_file" || rc=1
  done

  # Drop what the previous declaration had and this one does not.
  for name in $previous; do
    in_list "$name" $desired && continue
    if ! hook_installed "$name"; then
      continue
    fi
    if [ "$DRY_RUN" = 1 ]; then
      log "would remove: $name"
      continue
    fi
    remove_hook "$name" || rc=1
  done

  if [ "$DRY_RUN" != 1 ]; then
    mkdir -p "$STATE_BASE"
    : >"$HOOKS_STATE"
    for name in $desired; do
      printf '%s\n' "$name" >>"$HOOKS_STATE"
    done
  fi
  return "$rc"
}

# ------------------------------------------------------- quick settings tiles
# Settings.Secure.sysui_qs_tiles is the whole QS panel as ONE comma-separated
# list, so "add a tile" is a merge, not an overwrite: read the list, patch it,
# write it back. Writing the raw key with `secure.sysui_qs_tiles = ...` still
# works for a full replace; `qs.add` / `qs.remove` in a manifest (or the
# qs-add / qs-remove commands) only touch the listed tiles, so they are safe to
# apply repeatedly and verify.
QS_KEY=sysui_qs_tiles

qs_read() {
  _v=$(as_root "settings get secure $QS_KEY" 2>/dev/null || true)
  _v=$(printf '%s' "$_v" | tr -d '[:space:]')
  # An unset list reads back as the literal string null.
  case "$_v" in '' | null) _v="" ;; esac
  printf '%s' "$_v"
}

qs_has() { # $1 = tile, $2 = csv list
  case ",$2," in
    *",$1,"*) return 0 ;;
    *) return 1 ;;
  esac
}

qs_without() { # $1 = tile, $2 = csv list -> the list without that tile
  _w_old=$2
  _w_out=""
  _w_ifs=$IFS
  IFS=,
  for _w_t in $_w_old; do
    if [ "$_w_t" != "$1" ]; then
      _w_out="${_w_out:+$_w_out,}$_w_t"
    fi
  done
  IFS=$_w_ifs
  printf '%s' "$_w_out"
}

qs_write() { # $1 = csv list
  as_root "settings put secure $QS_KEY '$(esc "$1")'"
}

# SystemUI reads the tile list at startup, so a change needs a restart to show
# up. Set NO_QS_RELOAD=1 to skip it (headless applies, tests).
qs_reload() {
  [ "${NO_QS_RELOAD:-0}" = 1 ] && return 0
  as_root "killall com.android.systemui" >/dev/null 2>&1 || true
}

qs_edit() { # $1 = mode (put|check), $2 = add|remove, $3 = csv of tiles
  _q_mode=$1
  _q_op=$2
  # Callers comma-join, which leaves a trailing comma.
  _q_tiles=${3%,}
  _q_cur=$(qs_read)
  _q_out=$_q_cur
  _q_rc=0
  _q_ifs=$IFS
  IFS=,
  for _q_t in $_q_tiles; do
    _q_t=$(printf '%s' "$_q_t" | tr -d '[:space:]')
    if [ -z "$_q_t" ]; then
      continue
    fi
    if qs_has "$_q_t" "$_q_cur"; then
      if [ "$_q_op" = add ]; then
        if [ "$_q_mode" = check ]; then log "ok: qs tile present: $_q_t"; fi
      else
        _q_out=$(qs_without "$_q_t" "$_q_out")
        if [ "$_q_mode" = check ]; then
          warn "diff: qs tile should be absent: $_q_t"
          _q_rc=1
        fi
      fi
    else
      if [ "$_q_op" = add ]; then
        _q_out="${_q_out:+$_q_out,}$_q_t"
        if [ "$_q_mode" = check ]; then
          warn "diff: qs tile missing: $_q_t"
          _q_rc=1
        fi
      else
        if [ "$_q_mode" = check ]; then log "ok: qs tile absent: $_q_t"; fi
      fi
    fi
  done
  IFS=$_q_ifs

  if [ "$_q_mode" = put ]; then
    if [ "$_q_out" = "$_q_cur" ]; then
      log "ok: qs tiles already $_q_op: $_q_tiles"
    elif [ "$DRY_RUN" = 1 ]; then
      log "would set: secure.$QS_KEY = $_q_out"
    elif qs_write "$_q_out"; then
      log "set: secure.$QS_KEY = $_q_out"
      qs_reload
    else
      warn "settings put failed: secure.$QS_KEY"
      _q_rc=1
    fi
  fi
  return "$_q_rc"
}

# One manifest line: "qs.add = tile[,tile]" / "qs.remove = tile[,tile]".
qs_line() {
  case "$1" in
    *=*) : ;;
    *)
      warn "bad qs line (want 'qs.add = TILE'): $1"
      return 1
      ;;
  esac
  _l_key=${1%%=*}
  _l_val=${1#*=}
  # Trim trailing whitespace off the key, leading whitespace off the value.
  _l_key=${_l_key%"${_l_key##*[![:space:]]}"}
  _l_val=${_l_val#"${_l_val%%[![:space:]]*}"}
  case "$_l_key" in
    qs.add | qs.remove) : ;;
    *)
      warn "bad qs op (want qs.add / qs.remove): $_l_key"
      return 1
      ;;
  esac
  [ -n "$_l_val" ] || { warn "no tiles given: $1"; return 1; }
  qs_edit "$2" "${_l_key#qs.}" "$_l_val"
}

# ------------------------------------------------------------------- apps
# Disabling apps the generic way: `pm disable-user --user 0` (reversible
# with `pm enable`) — the standard root mechanism, works for any user app
# and most system apps on any Android (verified on Android 15 / Nothing OS).
# `pm hide` needs system perms, `pm suspend` is device-policy territory.
valid_pkg_name() {
  case "$1" in
    '' | *[!a-zA-Z0-9._]*) return 1 ;;
    *) return 0 ;;
  esac
}

pkg_disabled() { # $1 = pkg id
  as_root "pm list packages -d '$1'" 2>/dev/null | grep -q "package:$1$"
}

disable_app() { # $1... = pkg ids
  for pkg in "$@"; do
    valid_pkg_name "$pkg" || die "invalid package id: '$pkg'"
    if pkg_disabled "$pkg"; then
      log "already disabled: $pkg"
      continue
    fi
    if as_root "pm disable-user --user 0 '$pkg'"; then
      log "disabled: $pkg"
    else
      warn "could not disable $pkg"
      rc=1
    fi
  done
  return "${rc:-0}"
}

enable_app() { # $1... = pkg ids
  for pkg in "$@"; do
    valid_pkg_name "$pkg" || die "invalid package id: '$pkg'"
    if as_root "pm enable '$pkg'"; then
      log "enabled: $pkg"
    else
      warn "could not enable $pkg"
      rc=1
    fi
  done
  return "${rc:-0}"
}

list_disabled() {
  as_root "pm list packages -d" | sed 's/^package://' || true
}

list_props() {
  for f in "$PROPS_DIR"/*.props; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .props)
    # The first line of every manifest is its one-line summary.
    desc=$(sed -n '1p' "$f" | sed 's/^# *//')
    printf '%-16s %s\n' "$name" "$desc"
  done
}

list_hooks() {
  for d in "$HOOKS_DIR"/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    if [ -x "$(hook_service_dir "$name")/run" ]; then
      st=$(SVDIR="$PREFIX/var/service" sv status "android-settings-$name" 2>/dev/null |
        cut -d: -f1 || true)
      [ -n "$st" ] || st=installed
      printf '%-16s installed (%s)\n' "$name" "$st"
    else
      printf '%-16s available\n' "$name"
    fi
  done
}

# -------------------------------------------------------------------- main
[ "${1:-}" != "" ] || die "usage: android-settings <apply|verify|list-props|notify|sync-hooks|qs-list|qs-add|qs-remove|install-hook|remove-hook|list-hooks>"
cmd=$1
shift

# Resolve one manifest argument into a path (see the usage note above).
resolve_manifest() {
  case "$1" in
    all)
      for f in "$PROPS_DIR"/*.props; do
        [ -f "$f" ] || continue
        printf '%s\n' "$f"
      done
      ;;
    */* | *.props) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$PROPS_DIR/$1.props" ;;
  esac
}

case "$cmd" in
  apply | verify)
    DRY_RUN=0
    manifests=""
    # Resolved paths are space-joined below (nix store paths never contain
    # spaces), which is what plain sh gives us for `set --`.
    for a in "$@"; do
      case "$a" in
        --dry-run) DRY_RUN=1 ;;
        *) manifests="$manifests $(resolve_manifest "$a")" ;;
      esac
    done
    # Only flags (or nothing) given -> the repo's applied manifest.
    [ -n "$manifests" ] || manifests="$(resolve_manifest default)"
    [ -n "$manifests" ] || die "no manifests to $cmd"
    # Intentional word-splitting of the manifest list.
    # shellcheck disable=SC2086
    set -- $manifests
    need_root
    if [ "$cmd" = apply ]; then
      do_apply "$@"
    else
      do_verify "$@"
    fi
    ;;
  install-hook)
    [ $# -ge 1 ] || die "install-hook NAME [--env-file FILE]"
    name=$1
    shift
    env_file=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --env-file)
          [ $# -ge 2 ] || die "--env-file needs an argument"
          env_file=$2
          shift 2
          ;;
        *) die "unknown option: $1" ;;
      esac
    done
    install_hook "$name" "$env_file"
    ;;
  remove-hook)
    [ $# -eq 1 ] || die "remove-hook NAME"
    remove_hook "$1"
    ;;
  disable-app)
    [ $# -ge 1 ] || die "disable-app PKG..."
    need_root
    disable_app "$@"
    ;;
  enable-app)
    [ $# -ge 1 ] || die "enable-app PKG..."
    need_root
    enable_app "$@"
    ;;
  list-disabled)
    need_root
    list_disabled
    ;;
  list-hooks)
    list_hooks
    ;;
  list-props)
    list_props
    ;;
  sync-hooks)
    sync_hooks "$@"
    ;;
  notify)
    [ $# -ge 1 ] || die "notify TITLE [BODY] [TAG]"
    n_title=$1
    shift
    n_body=""
    n_tag=android-settings
    if [ $# -ge 1 ]; then
      n_body=$1
      shift
    fi
    if [ $# -ge 1 ]; then
      n_tag=$1
      shift
    fi
    need_root
    command -v android_notify >/dev/null 2>&1 || die "notify helper missing: $LIB_DIR/notify.sh"
    android_notify "$n_title" "$n_body" "$n_tag" || die "could not post notification"
    log "notified: $n_title"
    ;;
  qs-list)
    need_root
    _tiles=$(qs_read)
    if [ -n "$_tiles" ]; then
      printf '%s\n' "$_tiles" | tr ',' '\n'
    else
      log "no qs tiles set ($QS_KEY is empty)"
    fi
    ;;
  qs-add)
    [ $# -ge 1 ] || die "qs-add TILE..."
    need_root
    qs_edit put add "$(printf '%s,' "$@")"
    ;;
  qs-remove)
    [ $# -ge 1 ] || die "qs-remove TILE..."
    need_root
    qs_edit put remove "$(printf '%s,' "$@")"
    ;;
  *)
    die "unknown command: $cmd (see header of $(basename "$0"))"
    ;;
esac
