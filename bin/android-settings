#!/data/data/com.termux/files/usr/bin/sh
# android-settings — declarative Android settings + hook services for the
# aliyss phone (repo: aliyss-android-settings, wired via home-manager).
#
# The engine lives in this repo (same pattern as aliyss-android-pkgs: the
# repo owns the engine, home-manager just calls it). It runs natively in a
# Termux shell and inside the nix chroot (home-manager activation); anything
# privileged goes through `su` (KernelSU) — or, where the chroot hides the real
# su, through KernelSU's ksud CLI via a generated shim (see lib/su.sh) — so the
# process itself stays in the app's SELinux domain — runit can always supervise
# the hooks.
#
# Usage:
#   android-settings apply [--dry-run] [--only-changed] [NAME|FILE...]
#   android-settings verify [--json] [NAME|FILE...]
#   android-settings lint [NAME|FILE...]         (offline; no root needed)
#   android-settings list-props
#   android-settings get NS KEY                  (settings get, as root)
#   android-settings set NS KEY VALUE
#   android-settings sync-hooks [--env-dir DIR] [--dry-run] NAME...
#       Install/refresh exactly NAME... (each session's env read from
#       <DIR>/<name>.env when given), remove hooks the previous run declared and
#       this one does not, and remember the list in
#       ~/.local/state/aliyss-android-settings/hooks. Installing is what creates
#       the runit service; an unchanged hook is left alone (no restart).
#   android-settings notify TITLE [BODY] [TAG]   (root; no Termux:API needed)
#   android-settings qs-list                (current QS tiles, one per line)
#   android-settings qs-add TILE...         (merge into the QS panel)
#   android-settings qs-remove TILE...      (drop from the QS panel)
#   android-settings disable-app PKG...     (pm disable-user --user 0)
#   android-settings enable-app PKG...      (pm enable)
#   android-settings list-disabled
#   android-settings install-hook NAME [--env-file FILE]
#   android-settings remove-hook NAME
#   android-settings restart-hook NAME      (bounce a running service)
#   android-settings reinstall-hooks [NAME...]   (re-copy from the package)
#   android-settings test-hook NAME [SECONDS]    (foreground, one-off run)
#   android-settings log NAME [-f]          (hook log; -f follows)
#   android-settings logs                   (installed hook logs, with sizes)
#   android-settings status                 (services + declared hooks)
#   android-settings list-hooks
#
# A manifest argument is a path (anything with a slash or a .props suffix), a
# bare name resolved against props/ (<name>.props), or `all` for every manifest
# in props/ sorted. With no argument, props/default.props is used.
#
# Manifest format (see props/default.props):
#   # comment
#   global.window_animation_scale = 0.75   # namespace.key = value
#   cmd:wm density 440                     # raw command, run as root
#   qs.add = flashlight                    # ensure QS tiles are in the panel
#   qs.remove = cast                       # ensure QS tiles are not in the panel
#   include sound                          # splice props/sound.props in place
set -eu

# $PREFIX is a Termux-shell concept: inside the nix chroot (home-manager
# activation) it is unset, so default to the standard Termux prefix.
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
BIN_DIR=$(dirname "$SELF")
ROOT=$(dirname "$BIN_DIR")

# In-store layout ($out/share/...) vs in-tree layout (hooks/ next to bin/).
if [ -d "$ROOT/share/android-settings/hooks" ]; then
  HOOKS_DIR="$ROOT/share/android-settings/hooks"
  PROPS_DIR="$ROOT/share/android-settings/props"
  LIB_DIR="$ROOT/share/android-settings/lib"
else
  HOOKS_DIR="$ROOT/hooks"
  PROPS_DIR="$ROOT/props"
  LIB_DIR="$ROOT/lib"
fi

STATE_BASE="$HOME/.local/state/aliyss-android-settings"
HOOKS_STATE="$STATE_BASE/hooks"
LOG_BASE="$STATE_BASE/logs"
LIBEXEC_DIR="$HOME/.local/libexec/android-settings"
SERVICE_BASE="$PREFIX/var/service/android-settings"

# Shared helpers. su.sh reads AS_STATE_BASE for its shim / stderr file, so point
# it at the engine's state dir before sourcing; both are optional so the engine
# still works when only the binary was copied out of the store.
export AS_STATE_BASE="$STATE_BASE"
# shellcheck disable=SC1090,SC1091
[ -f "$LIB_DIR/su.sh" ] && . "$LIB_DIR/su.sh"
# shellcheck disable=SC1090,SC1091
[ -f "$LIB_DIR/notify.sh" ] && . "$LIB_DIR/notify.sh"

log() { printf '[android-settings] %s\n' "$*"; }
warn() { printf '[android-settings] !! %s\n' "$*" >&2; }
die() { warn "$*"; exit 1; }

# A missing lib/ is worth saying out loud once: without su.sh every root call
# below silently becomes "command not found".
if ! command -v resolve_su >/dev/null 2>&1; then
  die "lib/su.sh not found next to the engine (looked in $LIB_DIR)"
fi

# Escape single quotes for the inner shell su -c spawns.
esc() { printf '%s' "$1" | sed "s/'/'\\\\''/g"; }

# ---------------------------------------------------------------- manifest
# Resolve one manifest argument into a path (see the usage note above).
resolve_manifest() {
  case "$1" in
    all)
      for f in "$PROPS_DIR"/*.props; do
        [ -f "$f" ] || continue
        printf '%s\n' "$f"
      done
      ;;
    */* | *.props) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$PROPS_DIR/$1.props" ;;
  esac
}

# `include NAME` / `include=NAME` splices another manifest in place, which is
# how default.props composes the library files. Recursion is refused rather than
# guarded against with a depth limit: an include cycle is always a mistake.
INCLUDE_STACK=""

# Resolve one include target:
#   NAME           a bare name is a library file     -> props/NAME.props
#   dir/FILE.props a path is relative to the file that includes it, so a
#                  manifest stays correct wherever it is invoked from
#   /abs/path      used as given
resolve_include() { # $1 = target as written, $2 = the including manifest
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    */* | *.props) printf '%s\n' "$(dirname "$2")/$1" ;;
    *) printf '%s\n' "$PROPS_DIR/$1.props" ;;
  esac
}

process_manifest() {
  file=$1
  [ -f "$file" ] || die "manifest not found: $file"
  case ":$INCLUDE_STACK:" in
    *":$file:"*) warn "include cycle, skipped: $file"; return 0 ;;
  esac
  INCLUDE_STACK="$INCLUDE_STACK:$file"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '' | '#'*) continue ;;
    esac
    # Trim leading whitespace.
    line=${line#"${line%%[![:space:]]*}"}
    case "$line" in '' | '#'*) continue ;; esac

    case "$line" in
      include\ * | include=*)
        _inc=${line#include}
        _inc=${_inc#=}
        _inc=${_inc# }
        # Trim trailing whitespace off the value.
        _inc=${_inc%"${_inc##*[![:space:]]}"}
        [ -n "$_inc" ] || { warn "empty include in $file"; continue; }
        _inc_path=$(resolve_include "$_inc" "$file")
        process_manifest "$_inc_path" || return 1
        continue
        ;;
    esac

    process_line "$line" || return 1
  done <"$file"
}

# Split "key = value" into the globals LKEY / LVALUE (whitespace trimmed).
split_kv() { # $1 = "key = value"
  LKEY=${1%%=*}
  LVALUE=${1#*=}
  LKEY=${LKEY%"${LKEY##*[![:space:]]}"}
  LVALUE=${LVALUE#"${LVALUE%%[![:space:]]*}"}
}

# --------------------------------------------------------------- apply/verify
DRY_RUN=0
ONLY_CHANGED=0
JSON=0

# verify --json accumulators. JSON is a report format, not a log format: when it
# is on, the per-line log/warn calls are replaced by items so the output stays
# parseable (home-manager's props-watch hook consumes it).
JSON_ITEMS=""
JSON_OK=0
JSON_BAD=0
JSON_UNVER=0

json_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

json_item() { # $1 = key, $2 = status, $3 = current, $4 = wanted
  JSON_ITEMS="$JSON_ITEMS${JSON_ITEMS:+,}{\"key\":\"$(json_esc "$1")\",\"status\":\"$2\",\"current\":\"$(json_esc "$3")\",\"wanted\":\"$(json_esc "$4")\"}"
}

# `bad` counts drift only — the exit status has to mean "something does not match",
# or a manifest with cmd: lines could never verify clean (and props-watch, which
# re-applies on a non-zero verify, would rewrite the phone forever). Unverifiable
# lines are counted separately and reported honestly.
json_count() { # $1 = status
  case "$1" in
    drift) JSON_BAD=$((JSON_BAD + 1)) ;;
    unverifiable) JSON_UNVER=$((JSON_UNVER + 1)) ;;
    *) JSON_OK=$((JSON_OK + 1)) ;;
  esac
}

# One result, in whichever format is active. The counts run in both modes so
# the closing summary is the same number the JSON would have reported.
report() { # $1 = key, $2 = status, $3 = current, $4 = wanted, $5 = human message
  json_count "$2"
  if [ "$JSON" = 1 ]; then
    json_item "$1" "$2" "$3" "$4"
    return 0
  fi
  case "$2" in
    ok) log "$5" ;;
    *) warn "$5" ;;
  esac
  return 0
}

settings_line() { # $1 = "ns.key", $2 = value, $3 = mode (put|check)
  ns=${1%%.*}
  key=${1#*.}
  case "$ns" in
    global | system | secure) : ;;
    *)
      warn "bad namespace in: $1 = $2 (global|system|secure)"
      return 1
      ;;
  esac
  case "$key" in
    '' | *'.'*) warn "bad key in: $1 = $2"; return 1 ;;
  esac

  if [ "$3" = put ]; then
    if [ "$DRY_RUN" = 1 ]; then
      log "would set: $ns.$key = $2"
      return 0
    fi
    # --only-changed reads first and skips the write when it already matches.
    # That is an extra root call per key, but it keeps a no-op switch from
    # re-writing everything (and, for the keys SystemUI watches, from churning).
    if [ "$ONLY_CHANGED" = 1 ]; then
      _oc_cur=$(as_root "settings get $ns '$(esc "$key")'" || true)
      case "$_oc_cur" in null) _oc_cur='' ;; esac
      if [ "$_oc_cur" = "$2" ]; then
        log "unchanged: $ns.$key = $2"
        return 0
      fi
    fi
    if as_root "settings put $ns '$(esc "$key")' '$(esc "$2")'"; then
      log "set: $ns.$key = $2"
      return 0
    fi
    warn "settings put failed: $ns.$key"
    return 1
  fi

  # check (verify mode)
  cur=$(as_root "settings get $ns '$(esc "$key")'" || true)
  case "$cur" in null) cur='' ;; esac
  if [ "$cur" = "$2" ]; then
    report "$1" ok "$cur" "$2" "ok: $ns.$key = $2"
  else
    report "$1" drift "$cur" "$2" "diff: $ns.$key — current '${cur:-<unset>}' wanted '$2'"
    return 1
  fi
}

cmd_line() { # $1 = raw command, $2 = mode (put|check)
  if [ "$2" = put ]; then
    if [ "$DRY_RUN" = 1 ]; then
      log "would run: $1"
      return 0
    fi
    if as_root "$1"; then
      log "ran: $1"
    else
      warn "cmd failed: $1"
      return 1
    fi
  else
    # A cmd: line has no readable state to compare, so verify reports it as
    # unverifiable rather than pretending it passed.
    report "cmd:$1" unverifiable "" "$1" "cmd (not verifiable): $1"
  fi
}

do_apply() {
  rc=0
  for m in "$@"; do
    INCLUDE_STACK=""
    process_line() {
      case "$1" in
        cmd:*) cmd_line "${1#cmd:}" put ;;
        qs.*) qs_line "$1" put || rc=1 ;;
        include\ * | include=*) : ;; # handled by process_manifest
        *)
          split_kv "$1"
          settings_line "$LKEY" "$LVALUE" put || rc=1
          ;;
      esac
    }
    process_manifest "$m" || rc=1
  done
  return "$rc"
}

do_verify() {
  rc=0
  for m in "$@"; do
    INCLUDE_STACK=""
    process_line() {
      case "$1" in
        cmd:*) cmd_line "${1#cmd:}" check ;;
        qs.*) qs_line "$1" check || rc=1 ;;
        include\ * | include=*) : ;;
        *)
          split_kv "$1"
          settings_line "$LKEY" "$LVALUE" check || rc=1
          ;;
      esac
    }
    process_manifest "$m" || rc=1
  done

  if [ "$JSON" = 1 ]; then
    printf '{"ok":%s,"bad":%s,"unverifiable":%s,"items":[%s]}\n' \
      "$JSON_OK" "$JSON_BAD" "$JSON_UNVER" "$JSON_ITEMS"
  else
    log "verify: ${JSON_OK} ok, ${JSON_BAD} not matching, ${JSON_UNVER} unverifiable"
  fi
  return "$rc"
}

# ---------------------------------------------------------------- lint
# Offline manifest check: no root, no device. Catches the mistakes that would
# otherwise only show up as a warn line during a switch — a typo'd namespace, a
# key that cannot be read back, a QS tile the ROM does not know.
#
# Warnings vs errors: an error means the line cannot work as written (bad
# namespace, malformed key); a warning means it will run but probably not do what
# the author meant (a read-only mirror, an unknown tile). Only errors set the
# exit status, so lint stays usable in a pipeline that tolerates ROM quirks.

# Tiles the AOSP/Quick-Settings surface defines (props/quicksettings.props).
QS_KNOWN_TILES="internet cell wifi bt flashlight dnd alarm airplane rotation
battery cast screenrecord hotspot nfc night dark saver location datasaver work
inversion color_correction reduce_brightness sensors_off mic camera
qr_code_scanner media_output record_issue hdr reading_mode vpn data_usage
wallet"

# Settings whose `global.*_on`-style key is a mirror the framework maintains:
# writing it looks like it worked but the service state does not follow.
MIRROR_KEYS="global.wifi_on global.bluetooth_on global.airplane_mode_on
global.mobile_data global.wifi_scan_always_enabled secure.ui_night_mode
secure.location_providers_allowed"

lint_has() { # $1 = needle, $2... = list
  _l_needle=$1
  shift
  for _l_c in "$@"; do
    [ "$_l_c" = "$_l_needle" ] && return 0
  done
  return 1
}

LINT_ERRORS=0
LINT_WARNINGS=0
LINT_LINES=0

lint_error() { LINT_ERRORS=$((LINT_ERRORS + 1)); warn "lint: $1"; }
lint_warn() { LINT_WARNINGS=$((LINT_WARNINGS + 1)); warn "lint: warning: $1"; }

lint_line() { # $1 = manifest line, $2 = file
  LINT_LINES=$((LINT_LINES + 1))
  case "$1" in
    include\ * | include=*)
      _l_inc=${1#include}
      _l_inc=${_l_inc#=}
      _l_inc=${_l_inc# }
      _l_inc=${_l_inc%"${_l_inc##*[![:space:]]}"}
      if [ -z "$_l_inc" ]; then
        lint_error "$2: empty include"
        return 0
      fi
      _l_path=$(resolve_include "$_l_inc" "$2")
      [ -f "$_l_path" ] || lint_error "$2: include target not found: $_l_inc"
      return 0
      ;;
    cmd:*)
      # Legitimate, but the one line class that runs arbitrary root commands —
      # worth naming in the report so a review sees it.
      lint_warn "$2: root command (verify cannot check it): ${1#cmd:}"
      return 0
      ;;
  esac

  case "$1" in
    qs.*)
      split_kv "$1"
      case "$LKEY" in
        qs.add | qs.remove) : ;;
        *)
          lint_error "$2: bad qs op (want qs.add / qs.remove): $LKEY"
          return 0
          ;;
      esac
      [ -n "$LVALUE" ] || { lint_error "$2: no tiles given: $1"; return 0; }
      # Split the tile list with tr, NOT by setting IFS=,: lint_has word-splits
      # the known-tile list, and a comma IFS would collapse it into one word.
      _l_tiles=$(printf '%s' "$LVALUE" | tr ',' '\n')
      for _l_t in $_l_tiles; do
        _l_t=$(printf '%s' "$_l_t" | tr -d '[:space:]')
        [ -n "$_l_t" ] || continue
        # shellcheck disable=SC2086
        lint_has "$_l_t" $QS_KNOWN_TILES || lint_warn "$2: unknown QS tile (ROM-dependent): $_l_t"
      done
      return 0
      ;;
    *=*) : ;;
    *)
      lint_error "$2: not a manifest line (want 'ns.key = value'): $1"
      return 0
      ;;
  esac

  split_kv "$1"
  _l_ns=${LKEY%%.*}
  _l_key=${LKEY#*.}
  case "$_l_ns" in
    global | system | secure) : ;;
    *) lint_error "$2: bad namespace: $LKEY (global|system|secure)"; return 0 ;;
  esac
  case "$_l_key" in
    '' | *'.'*) lint_error "$2: bad key: $LKEY"; return 0 ;;
  esac
  case "$_l_key" in
    *[!a-zA-Z0-9_]*)
      lint_warn "$2: key has characters Android does not use: $_l_key"
      ;;
  esac
  [ -n "$LVALUE" ] || lint_warn "$2: empty value: $LKEY"
  # shellcheck disable=SC2086
  lint_has "$LKEY" $MIRROR_KEYS &&
    lint_warn "$2: $LKEY is a read-only mirror — writing it may not take effect"
  return 0
}

do_lint() {
  for m in "$@"; do
    [ -f "$m" ] || { lint_error "manifest not found: $m"; continue; }
    INCLUDE_STACK=""
    # Includes are checked for existence, not spliced: each manifest is linted on
    # its own so a problem is reported in the file that actually has it (`lint
    # all` covers the whole library anyway).
    _lint_file=$m
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in '' | '#'*) continue ;; esac
      line=${line#"${line%%[![:space:]]*}"}
      case "$line" in '' | '#'*) continue ;; esac
      lint_line "$line" "$_lint_file"
    done <"$_lint_file"
  done

  if [ "$LINT_ERRORS" -gt 0 ]; then
    warn "lint: ${LINT_ERRORS} error(s), ${LINT_WARNINGS} warning(s) in ${LINT_LINES} line(s)"
    return 1
  fi
  log "lint: clean (${LINT_LINES} lines, ${LINT_WARNINGS} warning(s))"
  return 0
}

# ------------------------------------------------------------------- hooks
valid_hook_name() {
  case "$1" in
    '' | *[!a-z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

hook_service_dir() { printf '%s-%s' "$SERVICE_BASE" "$1"; }

svc_cmd() { # $1... = sv args
  SV="$PREFIX/bin/sv"
  command -v sv >/dev/null 2>&1 && SV=$(command -v sv)
  SVDIR="$PREFIX/var/service" "$SV" "$@" >/dev/null 2>&1 || true
}

# Shared helpers live next to the hooks: a runit-spawned hook runs natively in
# Termux, where the nix store is invisible, so it cannot use this engine.
copy_hook_libs() {
  mkdir -p "$LIBEXEC_DIR/lib"
  for _cl in su.sh hook.sh poll.sh notify.sh; do
    [ -f "$LIB_DIR/$_cl" ] || continue
    cp -f "$LIB_DIR/$_cl" "$LIBEXEC_DIR/lib/$_cl"
    chmod 644 "$LIBEXEC_DIR/lib/$_cl"
  done
}

install_hook() { # $1 = name, $2 = env file ("" = none)
  name=$1
  env_file=$2
  valid_hook_name "$name" || die "invalid hook name: '$name'"
  [ -d "$HOOKS_DIR/$name" ] || die "no such hook: $name"
  [ -x "$HOOKS_DIR/$name/run" ] || die "hook '$name' has no executable run script"
  need_root

  hook_real="$LIBEXEC_DIR/hooks/$name"
  service="$(hook_service_dir "$name")"
  mkdir -p "$hook_real"

  # Copy the hook out of the store as REAL files: /nix is invisible to native
  # Termux processes (and to runsv), same trick as the tailscaled daemon.
  cp -f "$HOOKS_DIR/$name/run" "$hook_real/run"
  chmod 755 "$hook_real/run"
  if [ -f "$HOOKS_DIR/$name/defaults" ]; then
    cp -f "$HOOKS_DIR/$name/defaults" "$hook_real/defaults"
  fi
  if [ -n "$env_file" ]; then
    [ -f "$env_file" ] || die "env file not found: $env_file"
    cp -f "$env_file" "$hook_real/env"
  else
    rm -f "$hook_real/env"
  fi

  copy_hook_libs

  mkdir -p "$service"
  cat >"$service/run" <<EOF
#!/data/data/com.termux/files/usr/bin/sh
# android-settings hook service: $name
# Managed by home-manager (aliyss.androidSettings) — do not edit by hand.
HOOK_DIR="\$HOME/.local/libexec/android-settings/hooks/$name"
# The hooks source the shared libs from here (a store path is invisible to a
# native Termux process, so install-hook keeps a real copy).
HOOK_LIB_DIR="\$HOME/.local/libexec/android-settings/lib"
export HOOK_LIB_DIR
# set -a: sourced vars must be EXPORTED — the hook is started with `exec`,
# which starts a fresh process that only inherits exported variables.
set -a
[ -f "\$HOOK_DIR/defaults" ] && . "\$HOOK_DIR/defaults"
[ -f "\$HOOK_DIR/env" ] && . "\$HOOK_DIR/env"
set +a
LOG_DIR="\$HOME/.local/state/aliyss-android-settings/logs"
mkdir -p "\$LOG_DIR"
{
  echo "=== $name hook spawned by runit at \$(date '+%Y-%m-%d %H:%M:%S') ==="
  exec "\$HOOK_DIR/run"
} >> "\$LOG_DIR/$name.log" 2>&1
EOF
  chmod 755 "$service/run"
  # No `down` file => termux-services autostarts the hook at Termux boot.
  rm -f "$service/down"

  if [ -d "$service/supervise" ]; then
    svc_cmd restart "android-settings-$name"
  else
    # runsvdir notices new dirs within a few seconds; `up` may fail until
    # then — harmless, the hook autostarts.
    svc_cmd up "android-settings-$name"
  fi
  log "hook installed: $name (service: android-settings-$name)"
}

remove_hook() { # $1 = name
  name=$1
  valid_hook_name "$name" || die "invalid hook name: '$name'"
  service="$(hook_service_dir "$name")"
  if [ -d "$service/supervise" ]; then
    svc_cmd down "android-settings-$name"
    sleep 1
  fi
  # runsv has exited after `sv down` + dir removal; never rm supervise/ of a
  # LIVE runsv (termux-services wedge, see tailscale.nix).
  rm -rf "$service"
  rm -rf "$LIBEXEC_DIR/hooks/$name"
  log "hook removed: $name"
}

# Declarative hook management for the nix side (home-manager activation): the
# caller passes the FULL list of hooks it wants, and this diffs it against what
# the previous run declared (tracked in $HOOKS_STATE, the file home-manager's
# activation used before this command existed). Installing is what creates the
# runit service, so nothing here runs a hook by itself either.
#
hook_installed() { # $1 = name
  [ -f "$LIBEXEC_DIR/hooks/$1/run" ]
}

hook_env_current() { # $1 = name, $2 = wanted env file ("" = none)
  _installed="$LIBEXEC_DIR/hooks/$1/env"
  if [ -n "$2" ]; then
    [ -f "$_installed" ] && cmp -s "$2" "$_installed"
  else
    [ ! -f "$_installed" ]
  fi
}

in_list() { # $1 = needle, $2... = haystack
  _needle=$1
  shift
  for _candidate in "$@"; do
    if [ "$_candidate" = "$_needle" ]; then
      return 0
    fi
  done
  return 1
}

# Names this engine knows about and has installed, one per line.
installed_hooks() {
  for d in "$LIBEXEC_DIR"/hooks/*/; do
    [ -d "$d" ] || continue
    basename "$d"
  done
}

sync_hooks() { # [--env-dir DIR] [--dry-run] NAME...
  env_dir=""
  desired=""
  rc=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --env-dir)
        [ $# -ge 2 ] || die "--env-dir needs an argument"
        env_dir=$2
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        desired="$desired $1"
        shift
        ;;
    esac
  done

  # A missing env dir is a caller bug, not "no config": failing loudly beats
  # silently installing every hook without its hookConfig env file.
  if [ -n "$env_dir" ] && [ ! -d "$env_dir" ]; then
    die "env dir not found: $env_dir"
  fi

  mkdir -p "$STATE_BASE"
  previous=""
  [ -f "$HOOKS_STATE" ] && previous=$(cat "$HOOKS_STATE" 2>/dev/null)

  # Install or refresh everything declared.
  for name in $desired; do
    if ! valid_hook_name "$name"; then
      warn "invalid hook name: '$name'"
      rc=1
      continue
    fi
    if [ ! -x "$HOOKS_DIR/$name/run" ]; then
      warn "no such hook in this package: $name (skipped)"
      rc=1
      continue
    fi

    env_file=""
    if [ -n "$env_dir" ] && [ -f "$env_dir/$name.env" ]; then
      env_file="$env_dir/$name.env"
    fi

    if hook_installed "$name" && hook_env_current "$name" "$env_file"; then
      log "unchanged: $name"
      continue
    fi
    if [ "$DRY_RUN" = 1 ]; then
      log "would install: $name (env: ${env_file:-none})"
      continue
    fi
    install_hook "$name" "$env_file" || rc=1
  done

  # Drop what the previous declaration had and this one does not.
  for name in $previous; do
    in_list "$name" $desired && continue
    if ! hook_installed "$name"; then
      continue
    fi
    if [ "$DRY_RUN" = 1 ]; then
      log "would remove: $name"
      continue
    fi
    remove_hook "$name" || rc=1
  done

  if [ "$DRY_RUN" != 1 ]; then
    mkdir -p "$STATE_BASE"
    : >"$HOOKS_STATE"
    for name in $desired; do
      printf '%s\n' "$name" >>"$HOOKS_STATE"
    done
  fi
  return "$rc"
}

# Bounce one service without touching its files. `restart` needs supervise/ to
# exist (i.e. runsv running) — otherwise there is nothing to restart.
restart_hook() { # $1 = name
  name=$1
  valid_hook_name "$name" || die "invalid hook name: '$name'"
  service="$(hook_service_dir "$name")"
  [ -d "$service/supervise" ] || die "hook not running: $name (install it first)"
  svc_cmd restart "android-settings-$name"
  log "restarted: $name"
}

# Re-copy installed hooks from the package (keeping each hook's own env file) and
# bounce them. This is the "I edited the hook and want it live now" path that
# otherwise means waiting for the next switch.
reinstall_hooks() { # $1... = names (default: every installed hook)
  names="$*"
  if [ -z "$names" ]; then
    names=$(installed_hooks)
  fi
  [ -n "$names" ] || { log "no hooks installed"; return 0; }
  need_root
  rc=0
  for name in $names; do
    if ! valid_hook_name "$name" || [ ! -x "$HOOKS_DIR/$name/run" ]; then
      warn "no such hook in this package: $name (skipped)"
      rc=1
      continue
    fi
    env_file=""
    [ -f "$LIBEXEC_DIR/hooks/$name/env" ] && env_file="$LIBEXEC_DIR/hooks/$name/env"
    install_hook "$name" "$env_file" || rc=1
  done
  return "$rc"
}

# Run a hook once, in the foreground, with its real env — the authoring loop
# that otherwise means editing, installing, switching, then reading a log.
# SECONDS=0 means "no timeout" (the hook loops until interrupted).
test_hook() { # $1 = name, $2 = seconds (default 5)
  name=$1
  secs=${2:-5}
  valid_hook_name "$name" || die "invalid hook name: '$name'"
  [ -x "$HOOKS_DIR/$name/run" ] || die "no such hook: $name"
  # The installed copy carries the hookConfig env; the package copy carries the
  # defaults. Prefer the installed one for each file so a test matches the
  # service as closely as possible.
  defaults="$HOOKS_DIR/$name/defaults"
  [ -f "$LIBEXEC_DIR/hooks/$name/defaults" ] && defaults="$LIBEXEC_DIR/hooks/$name/defaults"
  env_file="$LIBEXEC_DIR/hooks/$name/env"

  log "testing hook: $name (timeout: ${secs}s, env: ${env_file:-package defaults})"
  (
    cd "$HOOKS_DIR/$name" || exit 1
    HOOK_LIB_DIR="$LIB_DIR"
    export HOOK_LIB_DIR
    set -a
    # shellcheck disable=SC1090
    [ -f "$defaults" ] && . "$defaults"
    # shellcheck disable=SC1090
    [ -n "$env_file" ] && [ -f "$env_file" ] && . "$env_file"
    set +a
    if [ "$secs" = 0 ]; then
      exec ./run
    fi
    if command -v timeout >/dev/null 2>&1; then
      exec timeout "$secs" ./run
    fi
    # No timeout(1) (a stripped Termux): run it in the background and reap it.
    ./run &
    _th_pid=$!
    sleep "$secs"
    kill "$_th_pid" 2>/dev/null || true
    wait "$_th_pid" 2>/dev/null || true
  )
}

log_path() { printf '%s/%s.log' "$LOG_BASE" "$1"; }

# Tail one hook log; `-f` follows it (what `journalctl -f` would be here).
show_log() { # $1 = name, $2 = follow (0|1), $3 = lines
  name=$1
  lines=${3:-50}
  file=$(log_path "$name")
  if [ ! -f "$file" ]; then
    warn "no log for hook '$name' at $file"
    return 1
  fi
  if [ "${2:-0}" = 1 ]; then
    tail -n "$lines" -f "$file"
  else
    tail -n "$lines" "$file"
  fi
}

# Every installed hook's log, newest last, with size and mtime — enough to see
# which service is chattering and which has gone quiet.
list_logs() {
  found=0
  for name in $(installed_hooks); do
    file=$(log_path "$name")
    [ -f "$file" ] || continue
    found=1
    _l_size=$(wc -c <"$file" 2>/dev/null | tr -d '[:space:]')
    _l_when=$(date -r "$file" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '?')
    printf '%-18s %8s bytes  last write %s\n' "$name" "${_l_size:-0}" "$_l_when"
  done
  if [ "$found" = 0 ]; then
    log "no hook logs yet in $LOG_BASE"
    return 1
  fi
}

sv_status_of() { # $1 = name
  SV="$PREFIX/bin/sv"
  command -v sv >/dev/null 2>&1 && SV=$(command -v sv)
  SVDIR="$PREFIX/var/service" "$SV" status "android-settings-$1" 2>/dev/null || true
}

# One screen of "what is actually running": the declared hook ledger plus each
# installed service's runit status and last log line.
do_status() {
  declared=""
  [ -f "$HOOKS_STATE" ] && declared=$(tr '\n' ' ' <"$HOOKS_STATE" 2>/dev/null)
  log "declared hooks: ${declared:-none ($HOOKS_STATE)}"

  found=0
  for name in $(installed_hooks); do
    found=1
    _st=$(sv_status_of "$name")
    if [ -z "$_st" ]; then
      printf '%-18s installed, not supervised\n' "$name"
    else
      printf '%-18s %s\n' "$name" "$_st"
    fi
    _last=$(tail -n 1 "$(log_path "$name")" 2>/dev/null || true)
    [ -n "$_last" ] && printf '%-18s   %s\n' "" "$_last"
  done
  if [ "$found" = 0 ]; then
    log "no hooks installed (declare them in the dotfiles, or install-hook)"
    return 0
  fi
  root_state="unavailable"
  resolve_su >/dev/null 2>&1 && root_state="$SU_BIN"
  printf '%-18s %s\n' "root" "$root_state"
}

# ------------------------------------------------------- quick settings tiles
# Settings.Secure.sysui_qs_tiles is the whole QS panel as ONE comma-separated
# list, so "add a tile" is a merge, not an overwrite: read the list, patch it,
# write it back. Writing the raw key with `secure.sysui_qs_tiles = ...` still
# works for a full replace; `qs.add` / `qs.remove` in a manifest (or the
# qs-add / qs-remove commands) only touch the listed tiles, so they are safe to
# apply repeatedly and verify.
QS_KEY=sysui_qs_tiles

qs_read() {
  _v=$(as_root "settings get secure $QS_KEY" 2>/dev/null || true)
  _v=$(printf '%s' "$_v" | tr -d '[:space:]')
  # An unset list reads back as the literal string null.
  case "$_v" in '' | null) _v="" ;; esac
  printf '%s' "$_v"
}

qs_has() { # $1 = tile, $2 = csv list
  case ",$2," in
    *",$1,"*) return 0 ;;
    *) return 1 ;;
  esac
}

qs_without() { # $1 = tile, $2 = csv list -> the list without that tile
  _w_old=$2
  _w_out=""
  _w_ifs=$IFS
  IFS=,
  for _w_t in $_w_old; do
    if [ "$_w_t" != "$1" ]; then
      _w_out="${_w_out:+$_w_out,}$_w_t"
    fi
  done
  IFS=$_w_ifs
  printf '%s' "$_w_out"
}

qs_write() { # $1 = csv list
  as_root "settings put secure $QS_KEY '$(esc "$1")'"
}

# SystemUI reads the tile list at startup, so a change needs a restart to show
# up. Set NO_QS_RELOAD=1 to skip it (headless applies, tests).
qs_reload() {
  [ "${NO_QS_RELOAD:-0}" = 1 ] && return 0
  as_root "killall com.android.systemui" >/dev/null 2>&1 || true
}

qs_edit() { # $1 = mode (put|check), $2 = add|remove, $3 = csv of tiles
  _q_mode=$1
  _q_op=$2
  # Callers comma-join, which leaves a trailing comma.
  _q_tiles=${3%,}
  _q_cur=$(qs_read)
  _q_out=$_q_cur
  _q_rc=0
  _q_ifs=$IFS
  IFS=,
  for _q_t in $_q_tiles; do
    _q_t=$(printf '%s' "$_q_t" | tr -d '[:space:]')
    if [ -z "$_q_t" ]; then
      continue
    fi
    if qs_has "$_q_t" "$_q_cur"; then
      if [ "$_q_op" = add ]; then
        if [ "$_q_mode" = check ]; then report "qs.$_q_op $_q_t" ok "$_q_t" "$_q_t" "ok: qs tile present: $_q_t"; fi
      else
        _q_out=$(qs_without "$_q_t" "$_q_out")
        if [ "$_q_mode" = check ]; then
          report "qs.$_q_op $_q_t" drift "$_q_t" "" "diff: qs tile should be absent: $_q_t"
          _q_rc=1
        fi
      fi
    else
      if [ "$_q_op" = add ]; then
        _q_out="${_q_out:+$_q_out,}$_q_t"
        if [ "$_q_mode" = check ]; then
          report "qs.$_q_op $_q_t" drift "" "$_q_t" "diff: qs tile missing: $_q_t"
          _q_rc=1
        fi
      else
        if [ "$_q_mode" = check ]; then report "qs.$_q_op $_q_t" ok "" "" "ok: qs tile absent: $_q_t"; fi
      fi
    fi
  done
  IFS=$_q_ifs

  if [ "$_q_mode" = put ]; then
    if [ "$_q_out" = "$_q_cur" ]; then
      log "ok: qs tiles already $_q_op: $_q_tiles"
    elif [ "$DRY_RUN" = 1 ]; then
      log "would set: secure.$QS_KEY = $_q_out"
    elif qs_write "$_q_out"; then
      log "set: secure.$QS_KEY = $_q_out"
      qs_reload
    else
      warn "settings put failed: secure.$QS_KEY"
      _q_rc=1
    fi
  fi
  return "$_q_rc"
}

# One manifest line: "qs.add = tile[,tile]" / "qs.remove = tile[,tile]".
qs_line() {
  case "$1" in
    *=*) : ;;
    *)
      warn "bad qs line (want 'qs.add = TILE'): $1"
      return 1
      ;;
  esac
  split_kv "$1"
  case "$LKEY" in
    qs.add | qs.remove) : ;;
    *)
      warn "bad qs op (want qs.add / qs.remove): $LKEY"
      return 1
      ;;
  esac
  [ -n "$LVALUE" ] || { warn "no tiles given: $1"; return 1; }
  qs_edit "$2" "${LKEY#qs.}" "$LVALUE"
}

# ------------------------------------------------------------------- apps
# Disabling apps the generic way: `pm disable-user --user 0` (reversible
# with `pm enable`) — the standard root mechanism, works for any user app
# and most system apps on any Android (verified on Android 15 / Nothing OS).
# `pm hide` needs system perms, `pm suspend` is device-policy territory.
valid_pkg_name() {
  case "$1" in
    '' | *[!a-zA-Z0-9._]*) return 1 ;;
    *) return 0 ;;
  esac
}

pkg_disabled() { # $1 = pkg id
  as_root "pm list packages -d '$1'" 2>/dev/null | grep -q "package:$1$"
}

disable_app() { # $1... = pkg ids
  for pkg in "$@"; do
    valid_pkg_name "$pkg" || die "invalid package id: '$pkg'"
    if pkg_disabled "$pkg"; then
      log "already disabled: $pkg"
      continue
    fi
    if as_root "pm disable-user --user 0 '$pkg'"; then
      log "disabled: $pkg"
    else
      warn "could not disable $pkg"
      rc=1
    fi
  done
  return "${rc:-0}"
}

enable_app() { # $1... = pkg ids
  for pkg in "$@"; do
    valid_pkg_name "$pkg" || die "invalid package id: '$pkg'"
    if as_root "pm enable '$pkg'"; then
      log "enabled: $pkg"
    else
      warn "could not enable $pkg"
      rc=1
    fi
  done
  return "${rc:-0}"
}

list_disabled() {
  as_root "pm list packages -d" | sed 's/^package://' || true
}

# ------------------------------------------------------------- settings access
valid_ns() {
  case "$1" in
    global | system | secure) return 0 ;;
    *) return 1 ;;
  esac
}

# A one-off read/write without a manifest in the way: `settings get secure X`
# needs root and a namespace the engine validates, and that is the whole point.
settings_get() { # $1 = ns, $2 = key
  valid_ns "$1" || die "bad namespace: $1 (global|system|secure)"
  [ -n "$2" ] || die "settings get needs a key"
  need_root
  _g_out=$(as_root "settings get $1 '$(esc "$2")'") || die "settings get failed: $1.$2"
  printf '%s\n' "$_g_out"
}

settings_set() { # $1 = ns, $2 = key, $3 = value
  valid_ns "$1" || die "bad namespace: $1 (global|system|secure)"
  [ -n "$2" ] || die "settings set needs a key"
  [ $# -ge 3 ] || die "settings set needs a value"
  need_root
  as_root "settings put $1 '$(esc "$2")' '$(esc "$3")'" || die "settings put failed: $1.$2"
  log "set: $1.$2 = $3"
}

list_props() {
  for f in "$PROPS_DIR"/*.props; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .props)
    # The first line of every manifest is its one-line summary.
    desc=$(sed -n '1p' "$f" | sed 's/^# *//')
    printf '%-16s %s\n' "$name" "$desc"
  done
}

list_hooks() {
  for d in "$HOOKS_DIR"/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    if hook_installed "$name"; then
      st=$(sv_status_of "$name" | cut -d: -f1 || true)
      [ -n "$st" ] || st=installed
      printf '%-16s installed (%s)\n' "$name" "$st"
    else
      printf '%-16s available\n' "$name"
    fi
  done
}

# -------------------------------------------------------------------- main
[ "${1:-}" != "" ] || die "usage: android-settings <apply|verify|lint|list-props|get|set|notify|sync-hooks|qs-list|qs-add|qs-remove|install-hook|remove-hook|restart-hook|reinstall-hooks|test-hook|log|logs|status|list-hooks|disable-app|enable-app|list-disabled>"
cmd=$1
shift

case "$cmd" in
  apply | verify)
    DRY_RUN=0
    ONLY_CHANGED=0
    JSON=0
    manifests=""
    # Resolved paths are space-joined below (nix store paths never contain
    # spaces), which is what plain sh gives us for `set --`.
    for a in "$@"; do
      case "$a" in
        --dry-run) DRY_RUN=1 ;;
        --json)
          [ "$cmd" = verify ] || die "--json is only meaningful for verify"
          JSON=1
          ;;
        --only-changed)
          [ "$cmd" = apply ] || die "--only-changed is only meaningful for apply"
          ONLY_CHANGED=1
          ;;
        -*) die "unknown option: $a" ;;
        *) manifests="$manifests $(resolve_manifest "$a")" ;;
      esac
    done
    # Only flags (or nothing) given -> the repo's applied manifest.
    [ -n "$manifests" ] || manifests="$(resolve_manifest default)"
    [ -n "$manifests" ] || die "no manifests to $cmd"
    # Intentional word-splitting of the manifest list.
    # shellcheck disable=SC2086
    set -- $manifests
    need_root
    if [ "$cmd" = apply ]; then
      do_apply "$@"
    else
      do_verify "$@"
    fi
    ;;
  lint)
    manifests=""
    for a in "$@"; do
      case "$a" in
        -*) die "unknown option: $a" ;;
        *) manifests="$manifests $(resolve_manifest "$a")" ;;
      esac
    done
    [ -n "$manifests" ] || manifests="$(resolve_manifest default)"
    # shellcheck disable=SC2086
    set -- $manifests
    do_lint "$@"
    ;;
  get)
    [ $# -eq 2 ] || die "get NS KEY   (NS = global|system|secure)"
    settings_get "$1" "$2"
    ;;
  set)
    [ $# -ge 3 ] || die "set NS KEY VALUE   (NS = global|system|secure)"
    settings_set "$1" "$2" "$3"
    ;;
  install-hook)
    [ $# -ge 1 ] || die "install-hook NAME [--env-file FILE]"
    name=$1
    shift
    env_file=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --env-file)
          [ $# -ge 2 ] || die "--env-file needs an argument"
          env_file=$2
          shift 2
          ;;
        *) die "unknown option: $1" ;;
      esac
    done
    install_hook "$name" "$env_file"
    ;;
  remove-hook)
    [ $# -eq 1 ] || die "remove-hook NAME"
    remove_hook "$1"
    ;;
  restart-hook)
    [ $# -eq 1 ] || die "restart-hook NAME"
    restart_hook "$1"
    ;;
  reinstall-hooks)
    reinstall_hooks "$@"
    ;;
  test-hook)
    [ $# -ge 1 ] || die "test-hook NAME [SECONDS]"
    test_hook "$1" "${2:-5}"
    ;;
  log)
    [ $# -ge 1 ] || die "log NAME [-f]"
    follow=0
    lines=50
    name=$1
    shift
    while [ $# -gt 0 ]; do
      case "$1" in
        -f | --follow) follow=1 ;;
        -n)
          [ $# -ge 2 ] || die "-n needs a line count"
          lines=$2
          shift
          ;;
        *) die "unknown option: $1" ;;
      esac
      shift
    done
    show_log "$name" "$follow" "$lines"
    ;;
  logs)
    list_logs
    ;;
  status)
    do_status
    ;;
  disable-app)
    [ $# -ge 1 ] || die "disable-app PKG..."
    need_root
    disable_app "$@"
    ;;
  enable-app)
    [ $# -ge 1 ] || die "enable-app PKG..."
    need_root
    enable_app "$@"
    ;;
  list-disabled)
    need_root
    list_disabled
    ;;
  list-hooks)
    list_hooks
    ;;
  list-props)
    list_props
    ;;
  sync-hooks)
    sync_hooks "$@"
    ;;
  notify)
    [ $# -ge 1 ] || die "notify TITLE [BODY] [TAG]"
    n_title=$1
    shift
    n_body=""
    n_tag=android-settings
    if [ $# -ge 1 ]; then
      n_body=$1
      shift
    fi
    if [ $# -ge 1 ]; then
      n_tag=$1
      shift
    fi
    need_root
    command -v android_notify >/dev/null 2>&1 || die "notify helper missing: $LIB_DIR/notify.sh"
    android_notify "$n_title" "$n_body" "$n_tag" || die "could not post notification"
    log "notified: $n_title"
    ;;
  qs-list)
    need_root
    _tiles=$(qs_read)
    if [ -n "$_tiles" ]; then
      printf '%s\n' "$_tiles" | tr ',' '\n'
    else
      log "no qs tiles set ($QS_KEY is empty)"
    fi
    ;;
  qs-add)
    [ $# -ge 1 ] || die "qs-add TILE..."
    need_root
    qs_edit put add "$(printf '%s,' "$@")"
    ;;
  qs-remove)
    [ $# -ge 1 ] || die "qs-remove TILE..."
    need_root
    qs_edit put remove "$(printf '%s,' "$@")"
    ;;
  *)
    die "unknown command: $cmd (see header of $(basename "$0"))"
    ;;
esac
