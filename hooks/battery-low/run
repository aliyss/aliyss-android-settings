#!/data/data/com.termux/files/usr/bin/sh
# battery-low — notify when the battery crosses the threshold.
#
# Hook contract (aliyss-android-settings): the runit service run script
# sources defaults + env, then executes this file. It loops forever; runsv
# restarts it if it ever exits.
#
# Platform-native, no Termux:API: the level comes from `dumpsys battery` as root
# and the notification goes through the shared lib/notify.sh helper (which posts
# as the shell uid — see the header of lib/notify.sh). If the helper is missing —
# hook copied by hand — it degrades to a log line.
#
# Root, logging, state and the poll loop all come from the shared hook libs, so
# this file is only the battery logic.
#
# Env (defaults here, override via hookConfig in home-manager):
#   THRESHOLD       notify at/below this percentage   (default 15)
#   REARM_AT        re-arm at/above this percentage   (default THRESHOLD+5)
#   CHECK_INTERVAL  seconds between battery polls     (default 300)

HOOK_LIB_DIR="${HOOK_LIB_DIR:-$HOME/.local/libexec/android-settings/lib}"
. "$HOOK_LIB_DIR/hook.sh"
. "$HOOK_LIB_DIR/poll.sh"
hook_log_init battery-low

THRESHOLD=${THRESHOLD:-15}
CHECK_INTERVAL=${CHECK_INTERVAL:-300}
REARM_AT=${REARM_AT:-$((THRESHOLD + 5))}

# dumpsys battery as root. Status is the platform enum:
#   1 unknown, 2 charging, 3 discharging, 4 not charging, 5 full
# Sets level / status for the caller.
battery() {
  dump=$(as_root_out "dumpsys battery") || return 1
  level=$(
    printf '%s\n' "$dump" |
      sed -n 's/^ *level: *\([0-9][0-9]*\).*/\1/p' | head -n 1
  )
  code=$(
    printf '%s\n' "$dump" |
      sed -n 's/^ *status: *\([0-9][0-9]*\).*/\1/p' | head -n 1
  )
  case "$code" in
    2 | 5) status=CHARGING ;;
    3) status=DISCHARGING ;;
    4) status=NOT_CHARGING ;;
    *) status=UNKNOWN ;;
  esac
  [ -n "$level" ]
}

notified=$(state_get battery-low.notified)
: "${notified:=0}"

step() {
  if ! battery; then
    log "dumpsys battery failed (su denied? no root?)"
    return 0
  fi

  # Hysteresis: once fired, stay quiet until charging or REARM_AT.
  if [ "$notified" -eq 1 ]; then
    case "$status" in
      CHARGING)
        log "re-armed (status=$status)"
        notified=0
        ;;
      *)
        if [ "$level" -ge "$REARM_AT" ] 2>/dev/null; then
          log "re-armed (level=$level >= $REARM_AT)"
          notified=0
        fi
        ;;
    esac
  fi
  if [ "$notified" -eq 0 ] && [ "$level" -le "$THRESHOLD" ] 2>/dev/null; then
    hook_notify "Battery low" "Battery at ${level}% (alert at ${THRESHOLD}%)" battery-low
    log "notified at ${level}%"
    notified=1
  fi
  state_set battery-low.notified "$notified"
}

log "watching battery (notify <= ${THRESHOLD}%, re-arm >= ${REARM_AT}%) every ${CHECK_INTERVAL}s"
poll_start step
