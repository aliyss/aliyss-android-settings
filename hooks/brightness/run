#!/data/data/com.termux/files/usr/bin/sh
# brightness — watch the screen brightness and dispatch it as events.
#
# An event SOURCE for the dotfiles, in the spirit of key-remap: it polls the
# system brightness settings and runs a configured root command per event. The
# interesting case is the mode flip — ROMs (Nothing OS included) drop
# auto-brightness to manual as soon as you drag the slider, so the dotfiles can
# simply turn it back on; level events cover things like warning at 100%.
#
# Hook contract (aliyss-android-settings): sourced with env, executed natively in
# Termux under runit, loops forever. Nothing runs until the dotfiles declare the
# hook — home-manager calls `install-hook`, which is what creates the service.
#
# Logging, root, state, the action environment and the loop come from the shared
# hook libs (lib/hook.sh's ev_run, lib/poll.sh).
#
# Env (defaults here; override via hookConfig in home-manager):
#   CHECK_INTERVAL  seconds between polls                             (default 30)
#   STEP            level change (0-255) that counts as an event      (default 15)
#   MIN_INTERVAL    minimum seconds between level events              (default 60)
#   LEVEL_IN_AUTO   1 = also emit level events while auto-brightness  (default 0:
#                   auto ramps with ambient light, which would be spam)
#   MODE_ACTION     shell command run as root when auto<->manual flips
#   LEVEL_ACTION    shell command run as root when the level moves >= STEP
#   NOTIFY          1 = also post a built-in notification per event   (default 0)
#
# Action environment (exported for MODE_ACTION / LEVEL_ACTION):
#   EVENT=mode|level
#   MODE=auto|manual            PREV_MODE
#   BRIGHTNESS (0-255)          PREV_BRIGHTNESS
#   PERCENT (0-100)             PREV_PERCENT
#
# Actions run detached as root, like key-remap's gestures, so a slow command
# cannot stall the poll loop.

HOOK_LIB_DIR="${HOOK_LIB_DIR:-$HOME/.local/libexec/android-settings/lib}"
. "$HOOK_LIB_DIR/hook.sh"
. "$HOOK_LIB_DIR/poll.sh"
hook_log_init brightness

CHECK_INTERVAL=${CHECK_INTERVAL:-30}
STEP=${STEP:-15}
MIN_INTERVAL=${MIN_INTERVAL:-60}
LEVEL_IN_AUTO=${LEVEL_IN_AUTO:-0}
MODE_ACTION=${MODE_ACTION:-}
LEVEL_ACTION=${LEVEL_ACTION:-}
NOTIFY=${NOTIFY:-0}

# Both settings in ONE root shell: spawning `su` is the expensive part of a poll
# loop, and this runs every CHECK_INTERVAL. Sets cur_level / cur_mode (either may
# be empty when the setting is unset). Values are handed back as globals rather
# than as a joined string on purpose: `|` inside a ${x%%|*} pattern is
# alternation under mksh, so the split silently returns nothing there even though
# Termux's sh (dash) is fine with it.
read_state() {
  _bs_out=$(as_root_out "settings get system screen_brightness; settings get system screen_brightness_mode")
  cur_level=$(printf '%s\n' "$_bs_out" | sed -n 1p | tr -d '[:space:]')
  cur_mode=$(printf '%s\n' "$_bs_out" | sed -n 2p | tr -d '[:space:]')
  case "$cur_level" in null) cur_level='' ;; esac
  case "$cur_mode" in null) cur_mode='' ;; esac
}

percent() { # $1 = 0-255 level
  case "$1" in '' | *[!0-9]*) printf '' ;; *) printf '%s' "$(( $1 * 100 / 255 ))" ;; esac
}

emit() { # $1 = event, $2 = level, $3 = prev level, $4 = mode, $5 = prev mode
  case "$1" in
    mode)
      log "mode: ${5:-?} -> $4 (brightness ${2:-?}, $(percent "$2")%)"
      _ev_cmd=$MODE_ACTION
      _ev_title='Brightness mode'
      _ev_body="$4 (was ${5:-?}), $(percent "$2")%"
      ;;
    level)
      log "level: ${3:-?} -> $2 ($(percent "$2")%, $4)"
      _ev_cmd=$LEVEL_ACTION
      _ev_title='Brightness'
      _ev_body="$(percent "$2")% ($4)"
      ;;
  esac

  ev_run \
    EVENT "$1" \
    MODE "$4" PREV_MODE "$5" \
    BRIGHTNESS "$2" PREV_BRIGHTNESS "$3" \
    PERCENT "$(percent "$2")" PREV_PERCENT "$(percent "$3")" \
    "$_ev_cmd"

  [ "$NOTIFY" = 1 ] && hook_notify "$_ev_title" "$_ev_body" brightness
  return 0
}

# "<mode> <level>", split by `read` (no separator inside a pattern).
prev_mode=''
prev_level=''
_last_level_event=0

step() {
  read_state
  level=$cur_level
  case "$cur_mode" in
    1) mode=auto ;;
    *) mode=manual ;;
  esac
  now=$(date +%s)

  if poll_is_first_run brightness; then
    # First ever run: adopt what is on screen instead of firing on boot.
    poll_mark_adopted brightness
    prev_mode=$mode
    prev_level=$level
    state_set brightness "$prev_mode $prev_level"
    log "starting from mode=$prev_mode brightness=${prev_level:-?}"
    return 0
  fi

  if [ "$mode" != "$prev_mode" ]; then
    emit mode "$level" "$prev_level" "$mode" "$prev_mode"
    prev_mode=$mode
    prev_level=$level
    _last_level_event=$now
    state_set brightness "$prev_mode $prev_level"
    return 0
  fi

  [ -n "$level" ] && [ -n "$prev_level" ] || return 0
  _bs_diff=$(( level - prev_level ))
  [ "$_bs_diff" -lt 0 ] && _bs_diff=$(( -_bs_diff ))
  [ "$_bs_diff" -ge "$STEP" ] || return 0

  if [ "$mode" = auto ] && [ "$LEVEL_IN_AUTO" != 1 ]; then
    # Track it silently so the next manual change is measured from here.
    prev_level=$level
    state_set brightness "$prev_mode $prev_level"
    return 0
  fi

  [ $(( now - _last_level_event )) -ge "$MIN_INTERVAL" ] || return 0
  emit level "$level" "$prev_level" "$mode" "$prev_mode"
  prev_level=$level
  _last_level_event=$now
  state_set brightness "$prev_mode $prev_level"
}

# Resume from the last observed state across restarts. The adopt marker also
# tells the first run apart from a restart with a stale state file.
if [ -f "$(state_path brightness.adopted)" ]; then
  read -r prev_mode prev_level <"$(state_path brightness)" 2>/dev/null || true
fi

log "watching brightness (every ${CHECK_INTERVAL}s, step ${STEP}, level events in auto: ${LEVEL_IN_AUTO})"
poll_start step
