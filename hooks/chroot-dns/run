#!/data/data/com.termux/files/usr/bin/sh
# chroot-dns — keep name resolution working for everything the dotfiles run
# through the Nix chroot (~/.nix/bin/nix-chroot: git, ssh, curl, nix, the
# herdr/freebuff panes).
#
# The bug this guards against: the chroot runner drops to the Termux user with
# `busybox setuidgid`, and setuidgid clears EVERY supplementary group. A normal
# Android app also carries group inet (3003) — the group that owns the DNS proxy
# of netd (/dev/socket/dnsproxyd, mode 660 root:inet). Without it bionic cannot
# resolve anything inside the chroot: lookups fail with "No address associated
# with hostname" (EAI_NODATA) while raw-IP connections and busybox's own UDP DNS
# keep working. That is what makes a single host (github.com) look broken when in
# fact all name resolution inside the chroot is.
#
# The fix lives in the runner itself — it execs the user's command through
# util-linux setpriv with `--groups 3003` instead of setuidgid. That file is
# generated by aliyss-phone/nix-install.sh, so this hook is the guard: if the
# runner ever comes back without the fix (older dotfiles checkout, a
# re-bootstrap, a hand edit) it is repaired at boot and the repair is reported,
# rather than silently costing you DNS again.
#
# Hook contract (aliyss-android-settings): sourced with env, executed natively
# in Termux under runit, loops forever. Logging, state and the loop come from the
# shared hook libs.
#
# Env (defaults here, override via hookConfig in home-manager):
#   CHECK_INTERVAL  seconds between checks                          (default 300)
#   INET_GID        Android inet group id                           (default 3003)
#   TERMUX_UID      Termux app uid, the user the chroot drops to    (default 10393)
#   TERMUX_GID      Termux app gid                                  (default TERMUX_UID)
#   LAUNCHER        chroot runner to guard (default ~/.nix/bin/nix-chroot-run)
#   NOTIFY          1 = post a notification when the state changes  (default 1)

HOOK_LIB_DIR="${HOOK_LIB_DIR:-$HOME/.local/libexec/android-settings/lib}"
. "$HOOK_LIB_DIR/hook.sh"
. "$HOOK_LIB_DIR/poll.sh"
hook_log_init chroot-dns

CHECK_INTERVAL=${CHECK_INTERVAL:-300}
INET_GID=${INET_GID:-3003}
TERMUX_UID=${TERMUX_UID:-10393}
TERMUX_GID=${TERMUX_GID:-$TERMUX_UID}
LAUNCHER=${LAUNCHER:-$HOME/.nix/bin/nix-chroot-run}
NOTIFY=${NOTIFY:-1}
STORE=${STORE:-$HOME/.nix/nix}

# The setpriv the runner reaches for at run time. It has to be in the store the
# chroot binds at /nix, because the runner resolves it by glob *inside* the
# chroot; if it is missing (nix-collect-garbage) the runner silently falls back
# to setuidgid and DNS breaks again without the file ever changing.
store_setpriv() {
  for _s_p in "$STORE"/store/*util-linux-*/bin/setpriv; do
    if [ -x "$_s_p" ]; then
      printf '%s' "$_s_p"
      return 0
    fi
  done
  return 1
}

# ok        = runner carries the fix and setpriv is available
# unfixed   = runner still drops with setuidgid      -> repairable
# no-setpriv= fix present but setpriv was collected  -> needs a rebuild/update
# absent    = no runner (the chroot is not set up)
health() {
  [ -f "$LAUNCHER" ] || { printf 'absent'; return 0; }
  grep -q -- "--groups $INET_GID" "$LAUNCHER" || { printf 'unfixed'; return 0; }
  store_setpriv >/dev/null 2>&1 || { printf 'no-setpriv'; return 0; }
  printf 'ok'
}

# Rewrite the drop line in place, keeping the setuidgid line as the fallback.
# Only a runner that still has the plain setuidgid line is touched, so a runner
# with a different shape is reported instead of mangled.
repair() {
  _r_new="$LAUNCHER.new.$$"
  awk -v gid="$INET_GID" -v uid="$TERMUX_UID" -v ugid="$TERMUX_GID" '
    hit { print; next }
    /exec \/bin\/busybox setuidgid u0_a393/ {
      print "  # Name resolution needs the supplementary group inet (" gid "): bionic"
      print "  # resolves through the DNS proxy of netd (/dev/socket/dnsproxyd, mode 660"
      print "  # root:inet) and busybox setuidgid clears every supplementary group, so"
      print "  # every lookup inside the chroot died with \"No address associated with"
      print "  # hostname\". setpriv restores the group and still drops to the Termux user."
      print "  # (chroot-dns fix - guarded by the chroot-dns hook in aliyss-android-settings)"
      print "  SP=\"$(ls -d /nix/store/*util-linux-*/bin/setpriv 2>/dev/null | sort | tail -n 1)\""
      print "  if [ -n \"$SP\" ]; then"
      print "    exec \"$SP\" --groups " gid " --reuid " uid " --regid " ugid " \"$@\""
      print "  fi"
      print "  exec /bin/busybox setuidgid u0_a393 \"$@\""
      hit = 1; next
    }
    { print }
    END { if (!hit) exit 3 }
  ' "$LAUNCHER" >"$_r_new" 2>/dev/null || { rm -f "$_r_new"; return 1; }

  # Only replace a runner that parses, so a bad edit can never leave the chroot
  # unusable.
  sh -n "$_r_new" 2>/dev/null || { rm -f "$_r_new"; return 1; }
  chmod --reference="$LAUNCHER" "$_r_new" 2>/dev/null || chmod 700 "$_r_new"
  mv "$_r_new" "$LAUNCHER"
}

state=$(state_get chroot-dns)

step() {
  now=$(health)

  [ "$now" != "$state" ] || return 0

  case "$now" in
    ok)
      if [ -n "$state" ]; then
        log "healthy: chroot runs with the inet group"
        [ "$NOTIFY" = 1 ] && hook_notify 'chroot DNS recovered' 'Name resolution works again for tools run through the Nix chroot'
      else
        log "healthy: runner carries the inet-group fix"
      fi
      ;;
    unfixed)
      if repair; then
        log "repaired $LAUNCHER (inet group $INET_GID restored)"
        [ "$NOTIFY" = 1 ] && hook_notify 'chroot DNS repaired' 'The Nix chroot runner was dropping the inet group; name resolution is fixed'
        now=$(health)
      else
        log "could not repair $LAUNCHER (unexpected format)"
        [ "$NOTIFY" = 1 ] && hook_notify 'chroot DNS at risk' 'The Nix chroot runner has an unexpected format; tools run in the chroot will fail to resolve names'
      fi
      ;;
    no-setpriv)
      log "fix present but no util-linux setpriv in $STORE/store — chroot DNS will fall back to setuidgid and break"
      [ "$NOTIFY" = 1 ] && hook_notify 'chroot DNS at risk' 'util-linux setpriv is missing from the Nix store; update the phone to restore it'
      ;;
    absent)
      log "no chroot runner at $LAUNCHER — nothing to guard"
      ;;
  esac
  state=$now
  state_set chroot-dns "$state"
}

log "guarding $LAUNCHER (every ${CHECK_INTERVAL}s, inet group ${INET_GID})"
poll_start step
