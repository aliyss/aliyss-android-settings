#!/data/data/com.termux/files/usr/bin/bash
# key-remap — remap hardware keys (e.g. the Nothing Essential Key) at the
# evdev layer. Replaces the Keymapper app: listens on ONE input device via
# root `getevent -t`, detects short / double / long presses of one scancode,
# and dispatches each gesture to an arbitrary shell command run as root.
#
# Hook contract (aliyss-android-settings): sourced with env, executed
# natively in Termux under runit. Loops forever.
#
# This hook is event-driven rather than polling, so it uses only hook.sh's
# logging and root helpers — actions go out through as_root_detached, which
# resolves su the same way the engine does (probe, then the ksud shim when the
# real su is hidden inside the Nix chroot).
#
# Env (defaults here; override via hookConfig in home-manager):
#   SCANCODE        scancode of the key, hex WITHOUT 0x (default 00fa =
#                   the Essential Key; getevent prints it as 0xfa)
#   KEY_DEVICE      input node to listen on. The Essential Key is reported on
#                   the gpio-keys node (verified: /dev/input/event0). Listening
#                   to a single node avoids the touchscreen event flood, which
#                   is what made the old all-devices reader drop key-ups.
#   SINGLE_ACTION   shell command run as root on a short press
#   DOUBLE_ACTION   ... on a double press
#   LONG_ACTION     ... on a long press
#   LONG_PRESS_MS   hold duration that counts as long press (default 500)
#   DOUBLE_PRESS_MS max gap between presses for a double (default 350)
#
# Gesture semantics (mirrors Keymapper):
#   short  : press+release, released before LONG_PRESS_MS, no second press
#            inside DOUBLE_PRESS_MS
#   double : second press starts within DOUBLE_PRESS_MS of the first release
#   long   : held >= LONG_PRESS_MS (fires while still held)
#   A double consumes both clicks; a long press is never followed by a short.
#
# Implementation note: this is a SINGLE-THREADED state machine. Press
# durations and the double gap are computed from the kernel's monotonic event
# timestamps (exact, immune to wall-clock jumps), while a 50 ms `read -t`
# timeout drives the two real-time decisions (fire long while held / resolve a
# pending single after the double window). No shared state files and no
# background timer subshells -> nothing to race.
#
# Test/offline: set DEVICE_CMD to supply events instead of starting getevent,
# e.g. DEVICE_CMD="cat captured.log" and NO_CLEANUP=1.

HOOK_LIB_DIR="${HOOK_LIB_DIR:-$HOME/.local/libexec/android-settings/lib}"
. "$HOOK_LIB_DIR/hook.sh"
hook_log_init key-remap

SCANCODE=${SCANCODE:-00fa}
LONG_PRESS_MS=${LONG_PRESS_MS:-500}
DOUBLE_PRESS_MS=${DOUBLE_PRESS_MS:-350}
KEY_DEVICE=${KEY_DEVICE:-/dev/input/event0}
TICK=${TICK:-0.05}

mkdir -p "$STATE_DIR/logs"

# Scancode exactly as getevent prints it (4 lowercase hex digits).
SC_HEX=$(printf '%04x' "0x$SCANCODE")

now_ms() { date +%s%3N; }

# Milliseconds between two kernel timestamps (float seconds).
ms_between() { awk "BEGIN{printf \"%d\", (\"$1\" - \"$2\") * 1000}"; }

fire() { # $1 = action env var name, $2 = gesture label
  local cmd
  eval "cmd=\${$1}"
  [ -n "$cmd" ] || return 0
  log "$2 -> running action"
  as_root_detached "$cmd"
}

# ---- state machine ----------------------------------------------------------
state=idle          # idle | down | long | pending
down_ts=""          # kernel ts of the current press
down_wall=0         # wall ms when the current press started (for long-while-held)
pending_ts=""       # kernel ts of the release awaiting a possible double
pending_wall=0      # wall ms of that release (to resolve the single press)

on_down() {
  local ts=$1
  case "$state" in
    pending)
      if [ "$(ms_between "$ts" "$pending_ts")" -le "$DOUBLE_PRESS_MS" ]; then
        state=idle
        fire DOUBLE_ACTION "double press"
        return
      fi
      # Second press came too late: resolve the single, then start fresh.
      state=idle
      fire SINGLE_ACTION "short press"
      ;;
    down|long) return 0 ;;   # duplicate DOWN, or still held after a long press
  esac
  down_ts=$ts
  down_wall=$(now_ms)
  state=down
}

on_up() {
  local ts=$1 held
  case "$state" in
    down)
      held=$(ms_between "$ts" "$down_ts")
      if [ "$held" -ge "$LONG_PRESS_MS" ]; then
        state=idle
        fire LONG_ACTION "long press (${held}ms, late)"
      else
        state=pending
        pending_ts=$ts
        pending_wall=$(now_ms)
      fi
      ;;
    long) state=idle ;;
    *)    return 0 ;;   # idle / pending duplicate -> ignore
  esac
}

on_tick() {
  case "$state" in
    down)
      if [ $(( $(now_ms) - down_wall )) -ge "$LONG_PRESS_MS" ]; then
        state=long
        fire LONG_ACTION "long press"
      fi
      ;;
    pending)
      if [ $(( $(now_ms) - pending_wall )) -gt "$DOUBLE_PRESS_MS" ]; then
        state=idle
        fire SINGLE_ACTION "short press"
      fi
      ;;
  esac
}

handle_line() {
  local line=$1 ts type code value n
  local -a f
  # Use the LAST three whitespace fields: `[ ts] dev: type code value` when
  # getevent reads all devices, `[ ts] type code value` when one device is
  # given — both parse the same way.
  read -ra f <<<"$line"
  n=${#f[@]}
  [ "$n" -ge 3 ] || return 0
  type=${f[n-3]}
  code=${f[n-2]}
  value=${f[n-1]}
  [ "$type" = "0001" ] || return 0        # EV_KEY only
  [ "$code" = "$SC_HEX" ] || return 0     # our scancode only
  ts=${line#*[}; ts=${ts%%]*}             # kernel monotonic seconds (float)
  case "$value" in
    00000001) on_down "$ts" ;;
    00000000) on_up "$ts" ;;
  esac
}

# ---- singleton cleanup ------------------------------------------------------
# runit's restart only kills the run script; it ORPHANS the `su getevent | while`
# pipeline. Kill every other instance of this script, then every root getevent
# (whose owner is gone). Skipped for offline replay.
if [ -z "$DEVICE_CMD" ] && [ -z "$NO_CLEANUP" ]; then
  for _p in $(pgrep -f "android-settings/hooks/key-remap/run" 2>/dev/null); do
    [ "$_p" = "$$" ] || kill "$_p" 2>/dev/null || true
  done
  # Single quotes are the point: $(pidof) must expand inside the ROOT shell.
  # shellcheck disable=SC2016
  as_root 'kill $(pidof getevent) 2>/dev/null' >/dev/null 2>&1 || true
  sleep 1
fi

log "remap live: scancode 0x$SC_HEX on ${KEY_DEVICE} (short/double/long = ${SINGLE_ACTION:+cmd}/${DOUBLE_ACTION:+cmd}/${LONG_ACTION:+cmd})"

# Default event source: root getevent on the one device that carries the key.
# (With one device specified, getevent omits the device-name column.)
if [ -n "$DEVICE_CMD" ]; then
  GE="$DEVICE_CMD"
else
  GE="/system/bin/su -c 'PATH=/system/bin:\$PATH; export PATH; exec getevent -t $KEY_DEVICE'"
fi

eval "$GE" | while :; do
  IFS= read -r -t "$TICK" _line
  _rc=$?
  if [ "$_rc" -gt 128 ]; then      # read timed out -> housekeeping tick
    on_tick
    continue
  fi
  [ "$_rc" -ne 0 ] && break        # EOF (device gone / replay finished)
  handle_line "$_line"
done
