#!/data/data/com.termux/files/usr/bin/sh
# night-dark — switch the system dark theme (cmd uimode) on a daily window.
# Needs root (KernelSU su) for `cmd uimode night yes|no`. Runs natively in
# Termux under runit (android-settings hook contract).
#
# Env:
#   NIGHT_START     window start HH:MM (may cross midnight)   (default 22:00)
#   NIGHT_END       window end HH:MM                          (default 07:00)
#   CHECK_INTERVAL  seconds between checks                    (default 60)

NIGHT_START=${NIGHT_START:-22:00}
NIGHT_END=${NIGHT_END:-07:00}
CHECK_INTERVAL=${CHECK_INTERVAL:-60}

STATE_DIR="$HOME/.local/state/aliyss-android-settings"
STATE_FILE="$STATE_DIR/state/night-dark"
mkdir -p "$STATE_DIR/state"

# su resolution (KernelSU puts it on /system, not in the Termux prefix).
SU_BIN=$(command -v su 2>/dev/null || printf /system/bin/su)

log() { printf '[night-dark] %s\n' "$(date +%H:%M:%S) $*"; }

ge() { [ "$1" \> "$2" ] || [ "$1" = "$2" ]; }
lt() { [ "$1" \< "$2" ]; }

in_window() {
  now=$(date +%H:%M)
  if lt "$NIGHT_START" "$NIGHT_END"; then
    ge "$now" "$NIGHT_START" && lt "$now" "$NIGHT_END"
  else
    ge "$now" "$NIGHT_START" || lt "$now" "$NIGHT_END"
  fi
}

set_ui_mode() { # $1 = night|off
  # PATH pin inside the root shell: it is not guaranteed to include
  # /system/bin (fails with `cmd: inaccessible or not found` otherwise).
  if [ "$1" = night ]; then
    "$SU_BIN" -c "PATH=/system/bin:\$PATH; export PATH; cmd uimode night yes" >/dev/null 2>&1
  else
    "$SU_BIN" -c "PATH=/system/bin:\$PATH; export PATH; cmd uimode night no" >/dev/null 2>&1
  fi
}

last=""
[ -f "$STATE_FILE" ] && last=$(cat "$STATE_FILE" 2>/dev/null)

log "dark-theme window ${NIGHT_START}-${NIGHT_END} (check every ${CHECK_INTERVAL}s)"

while :; do
  if in_window; then
    want=night
  else
    want=off
  fi
  if [ "$want" != "$last" ]; then
    if set_ui_mode "$want"; then
      log "dark theme $want"
      printf '%s' "$want" >"$STATE_FILE"
      last=$want
    else
      log "cmd uimode failed (su denied? Android version?)"
    fi
  fi
  sleep "$CHECK_INTERVAL"
done
