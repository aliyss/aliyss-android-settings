# aliyss-android-settings — reference settings manifest
#
# Format:
#   namespace.key = value     namespace is global | system | secure
#   cmd:<shell command>       run raw as root (ONLY in manifests you trust!)
#   # / blank lines           ignored
#
# Apply:  android-settings apply [FILE...]   (home-manager runs this on switch)
# Check:  android-settings verify [FILE...]

global.window_animation_scale = 0.75
global.transition_animation_scale = 0.75
global.animator_duration_scale = 0.75

# More examples (uncomment to use):
# system.screen_off_timeout = 120000           # 2 min
# global.stay_on_while_plugged_in = 0          # screen off while charging
# secure.screensaver_enabled = 0               # no daydream
# cmd:settings put global low_power_sticky 1   # raw command form
